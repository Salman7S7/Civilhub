# Server Port
PORT=4000

# Set to false for local development without MySQL.
DB_ENABLED=true

# OpenRouter AI Configuration (Primary AI Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=http://localhost:4000
OPENROUTER_SITE_NAME=CivilHub
OPENROUTER_MAX_TOKENS=1000

# Google Gemini Configuration (Fallback AI Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=civilhub_db
DB_PORT=3306