# Server Port
PORT=4000

# Set to false for local development without MySQL.
DB_ENABLED=true

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=civilhub_db
DB_PORT=3306